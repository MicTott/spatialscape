    given-names: Michael
    email: mictott@gmail.com
    affiliation: "Lieber Institute for Brain Development"
repository-code: "https://github.com/MicTott/spatialscape"
repository-artifact: "https://pypi.org/project/spatialscape/"
url: "https://mictott.github.io/spatialscape/docs/"
keywords:
  - spatial transcriptomics
  - single-cell
  - visualization
